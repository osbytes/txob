{
  "name": "txob",
  "description": "transactional outbox with typed events, per-handler deliveries, and concurrency controls for Postgres, MongoDB, Redis and DynamoDB",
  "keywords": [
    "outbox pattern",
    "transactional outbox",
    "event processor",
    "DDD",
    "microservices",
    "graceful shutdown",
    "horizontal scalability",
    "at-least-once",
    "at-least-once delivery",
    "redis",
    "valkey",
    "dynamodb",
    "mongodb",
    "postgres",
    "drizzle",
    "prisma",
    "kysely",
    "knex",
    "sequelize",
    "typeorm",
    "postgres.js"
  ],
  "author": "Dillon Streator <dillonstreator@gmail.com>",
  "homepage": "https://github.com/osbytes/txob",
  "repository": {
    "type": "git",
    "url": "git://github.com/osbytes/txob.git"
  },
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js",
      "require": "./dist/cjs/pg/index.js"
    },
    "./pg/drizzle": {
      "types": "./dist/pg/drizzle.d.ts",
      "import": "./dist/pg/drizzle.js",
      "require": "./dist/cjs/pg/drizzle.js"
    },
    "./pg/kysely": {
      "types": "./dist/pg/kysely.d.ts",
      "import": "./dist/pg/kysely.js",
      "require": "./dist/cjs/pg/kysely.js"
    },
    "./pg/prisma": {
      "types": "./dist/pg/prisma.d.ts",
      "import": "./dist/pg/prisma.js",
      "require": "./dist/cjs/pg/prisma.js"
    },
    "./pg/postgres": {
      "types": "./dist/pg/postgres.d.ts",
      "import": "./dist/pg/postgres.js",
      "require": "./dist/cjs/pg/postgres.js"
    },
    "./pg/sequelize": {
      "types": "./dist/pg/sequelize.d.ts",
      "import": "./dist/pg/sequelize.js",
      "require": "./dist/cjs/pg/sequelize.js"
    },
    "./pg/knex": {
      "types": "./dist/pg/knex.d.ts",
      "import": "./dist/pg/knex.js",
      "require": "./dist/cjs/pg/knex.js"
    },
    "./pg/typeorm": {
      "types": "./dist/pg/typeorm.d.ts",
      "import": "./dist/pg/typeorm.js",
      "require": "./dist/cjs/pg/typeorm.js"
    },
    "./mongodb": {
      "types": "./dist/mongodb/index.d.ts",
      "import": "./dist/mongodb/index.js",
      "require": "./dist/cjs/mongodb/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js",
      "require": "./dist/cjs/redis/index.js"
    },
    "./dynamodb": {
      "types": "./dist/dynamodb/index.d.ts",
      "import": "./dist/dynamodb/index.js",
      "require": "./dist/cjs/dynamodb/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/cjs/memory/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm-run-all clean build:esm build:cjs copy:files mark:cjs",
    "build:esm": "tsc --build",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "copy:files": "copyfiles package.json README.md LICENSE dist",
    "prepublishOnly": "yarn build",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.cjs.tsbuildinfo",
    "nuke": "rimraf node_modules dist",
    "test": "vitest",
    "test:ci": "yarn test --run --coverage",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.test.json",
    "mark:cjs": "node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "test:prepare": "prisma generate --schema test/prisma/schema.prisma",
    "changeset": "changeset",
    "version-packages": "changeset version && prettier -w CHANGELOG.md",
    "release": "changeset publish"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "throttle-debounce": "^5.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "drizzle-orm": ">=0.36.0",
    "knex": ">=2.0.0",
    "kysely": ">=0.27.0",
    "mongodb": "^7.0.0",
    "pg": "^8.0.0",
    "postgres": "^3.0.0",
    "sequelize": "^6.0.0",
    "typeorm": ">=0.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/lib-dynamodb": "^3",
    "@aws-sdk/util-dynamodb": "^3",
    "@changesets/changelog-github": "^0",
    "@changesets/cli": "^2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.10.9",
    "@types/throttle-debounce": "^5.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "dynamodb-toolbox": "^2.11.1",
    "dynamoose": "^4.2.0",
    "electrodb": "^3.9.3",
    "ioredis": "^6",
    "iovalkey": "^0.4.0",
    "knex": "^3.3.0",
    "kysely": "^0.29.7",
    "mongodb": "^7.0.0",
    "nodemon": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "pg": "^8.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.1.1",
    "prisma": "^7",
    "redis": "^6",
    "rimraf": "^6.0.1",
    "sequelize": "^6.37.8",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  },
  "resolutions": {
    "copyfiles/minimatch": "3.1.5",
    "copyfiles/**/minimatch": "3.1.5",
    "copyfiles/**/brace-expansion": "1.1.21",
    "copyfiles/minimatch/brace-expansion": "1.1.21",
    "copyfiles/**/minimatch/brace-expansion": "1.1.21",
    "nodemon/chokidar/anymatch/picomatch": "2.3.2",
    "nodemon/chokidar/readdirp/picomatch": "2.3.2",
    "npm-run-all/cross-spawn": "6.0.6",
    "npm-run-all/minimatch": "3.1.5",
    "npm-run-all/**/brace-expansion": "1.1.21",
    "npm-run-all/minimatch/brace-expansion": "1.1.21",
    "ts-node/diff": "4.0.4",
    "drizzle-kit/@esbuild-kit/esm-loader/@esbuild-kit/core-utils/esbuild": "0.25.12"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "peerDependenciesMeta": {
