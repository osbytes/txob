graph TB
    subgraph Application["Your Application"]
        AppTx["BEGIN"]
        AppData["Write business data"]
        AppPublish["outbox.publish(tx, type, data)<br/>validates with the event's schema"]
        AppCommit["COMMIT"]
        AppTx --> AppData --> AppPublish --> AppCommit
    end

    subgraph Database["Store (Postgres, MongoDB, Redis, DynamoDB, ...)"]
        Events[("txob_events<br/>id, type, data, correlation_id<br/>fanned_out_at, fanout lease")]
        Deliveries[("txob_deliveries<br/>one per (event, handler)<br/>status, attempts, priority,<br/>concurrency_key, run_after,<br/>lease_token, last_error")]
        Notify["Wakeup source<br/>pg_notify, change stream, pub/sub"]
    end

    AppCommit -->|"atomically with business data"| Events
    Events --> Notify
    Deliveries --> Notify

    subgraph Processor["Event Processor (run N for scale)"]
        Wakeup["Wakeup emitter<br/>(optional; polling otherwise)"]
        Poll["Poll (interval, wakeup,<br/>completion, backoff timers)"]
        Fanout["Fan-out<br/>lease unfanned events of handled types,<br/>create deliveries + mark fanned out<br/>(one statement, idempotent)"]
        Claim["Claim deliveries, priority order<br/>within limits counted across ALL processors:<br/>concurrency, per-key concurrency, rate limit<br/>(serialized per limited handler),<br/>set lease + token, attempts+1"]
        Run["Run handler<br/>signal aborted on: shutdown | timeoutMs | lease lost<br/>handler's own result decides the outcome"]
        Heartbeat["Heartbeat<br/>renew leases every leaseMs/3"]
        Record["Record result (fenced by lease token)<br/>completed | retry with backoff | dead"]
        DeadHook["onDeliveryDead<br/>(same transaction, can publish)"]
    end

    Notify --> Wakeup --> Poll
    Poll --> Fanout --> Claim
    Events -.-> Fanout
    Fanout -.-> Deliveries
    Deliveries -.-> Claim
    Claim --> Run --> Record
    Heartbeat -.->|"extend leases"| Deliveries
    Record -->|"dead"| DeadHook
    Record -.-> Deliveries
